{
    "tasks": [
        {
            "label": "Create build directory",
            "type": "shell",
            "command": "mkdir -p ${workspaceFolder}/build",
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "C/C++: gcc build active file",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-DIMGUI_IMPL_OPENGL_LOADER_GLEW",
                "${file}",
                "bin/src/*.cpp",
                "3rdparty/ImGUI/imgui.cpp",
                "3rdparty/ImGUI/imgui_draw.cpp",
                "3rdparty/ImGUI/imgui_widgets.cpp",
                "3rdparty/ImGUI/imgui_tables.cpp",
                "3rdparty/ImGUI/imgui_impl_glfw.cpp",
                "3rdparty/ImGUI/imgui_impl_opengl3.cpp",
                "3rdparty/freetype-gl/freetypeGL.cpp",
                "-x", "c", "3rdparty/freetype-gl/distance-field.c",
                "-x", "c", "3rdparty/freetype-gl/edtaa3func.c",
                "-x", "c", "3rdparty/freetype-gl/font-manager.c",
                "-x", "c", "3rdparty/freetype-gl/ftgl-utils.c",
                "-x", "c", "3rdparty/freetype-gl/platform.c",
                "-x", "c", "3rdparty/freetype-gl/text-buffer.c",
                "-x", "c", "3rdparty/freetype-gl/texture-atlas.c",
                "-x", "c", "3rdparty/freetype-gl/texture-font.c",
                "-x", "c", "3rdparty/freetype-gl/utf8-utils.c",
                "-x", "c", "3rdparty/freetype-gl/vector.c",
                "-x", "c", "3rdparty/freetype-gl/vertex-attribute.c",
                "-x", "c", "3rdparty/freetype-gl/vertex-buffer.c",
                "-x", "c++",
                "-I${workspaceFolder}/bin/inc",
                "-I${workspaceFolder}/3rdparty/gli",
                "-I${workspaceFolder}/3rdparty/ImGUI",
                "-I${workspaceFolder}/3rdparty/stb",
                "-I${workspaceFolder}/3rdparty/freetype-gl",
                "-I/usr/include/freetype2",
                "-o",
                "${workspaceFolder}/build/${fileBasenameNoExtension}",
                "-lGL",
                "-lGLU",
                "-lglut",
                "-lGLEW",
                "-lglfw",
                "-lassimp",
                "-lfreetype",
                "-lmeshoptimizer"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Create build directory",
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++ build active file",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${workspaceFolder}/build/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "dependsOn": "Create build directory",
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}
{
    "tasks": [
        {
            "label": "Create build directory",
            "type": "shell",
            "command": "mkdir -p ${workspaceFolder}/build",
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "C/C++: gcc build active file",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "utils/*.cpp",
                "includes/stb_image.cpp",
                "-I${workspaceFolder}/includes",
                "-o",
                "${workspaceFolder}/build/${fileBasenameNoExtension}",
                "-lGL",
                "-lGLU",
                "-lglut",
                "-lGLEW"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Create build directory",
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++ build active file",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${workspaceFolder}/build/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "dependsOn": "Create build directory",
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}